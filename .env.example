# Waitlist signups from the landing modal (app/api/waitlist/route.ts).
# A signup succeeds if at least one of the two sinks below records it.
# Unset both = signups are only logged to the server console.

# 1) Webhook — each signup is POSTed here as JSON:
# { email, intent: "borrow" | "lend", hardware?, amount?, notes?, source, ts }
# Any https URL that accepts a POST works (Zapier / Make catch hook, Google
# Apps Script web app, your own endpoint).
WAITLIST_WEBHOOK_URL=

# 2) Email via Resend (https://resend.com). Sends an internal notification to
# WAITLIST_NOTIFY_TO and a confirmation of the submitted details to the person
# who signed up. The FROM domain (resilabs.ai) must be verified in Resend.
RESEND_API_KEY=
# Optional overrides — these are the defaults:
# WAITLIST_EMAIL_FROM="Zipcode Finance <support@resilabs.ai>"
# WAITLIST_NOTIFY_TO=seby@resilabs.ai
# WAITLIST_REPLY_TO=support@resilabs.ai
